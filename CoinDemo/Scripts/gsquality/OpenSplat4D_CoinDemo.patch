diff -ru SourceAssets/OpenSplat4D_backup/Shaders/Private/GaussianSplatComposite.usf Plugins/OpenSplat4D/Shaders/Private/GaussianSplatComposite.usf
--- SourceAssets/OpenSplat4D_backup/Shaders/Private/GaussianSplatComposite.usf	2026-10-20 15:04:28.522055300 +0900
+++ Plugins/OpenSplat4D/Shaders/Private/GaussianSplatComposite.usf	2026-10-20 15:05:39.355162100 +0900
@@ -14,6 +14,21 @@
 
 Texture2D IntermediateTexture;
 SamplerState IntermediateSampler;
+// [CoinDemo] tone correction LUT, see GaussianSplatShaders.h
+float4 ToneLUT[16];
+float ToneCorrection;
+
+float3 ApplyToneLUT(float3 c)
+{
+	float3 t = saturate(c) * 15.0;
+	int3 i0 = min((int3)floor(t), 14);
+	float3 f = t - i0;
+	float3 r;
+	r.x = lerp(ToneLUT[i0.x].x, ToneLUT[i0.x + 1].x, f.x);
+	r.y = lerp(ToneLUT[i0.y].y, ToneLUT[i0.y + 1].y, f.y);
+	r.z = lerp(ToneLUT[i0.z].z, ToneLUT[i0.z + 1].z, f.z);
+	return r;
+}
 
 // Attempt to invert UE's ACES filmic tone curve so that display-ready gaussian
 // splat colors survive tone mapping unchanged.  Uses the Narkowicz ACES fit
@@ -67,6 +82,10 @@
 
 	// Un-premultiply to recover the actual composited sRGB color
 	float3 srgbColor = srgbAccum.rgb / srgbAccum.a;
+	if (ToneCorrection > 0.5)
+	{
+		srgbColor = ApplyToneLUT(srgbColor);
+	}
 
 	// Convert sRGB to linear for UE's SceneColor buffer
 	float3 linearColor = pow(max(srgbColor, 0.0), 2.2);
